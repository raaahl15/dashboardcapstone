{
  "name": "dme-capstone-master",
  "version": "1.1.0",
  "description": "Master Database & Operations Ecosystem for DME Plant Capstone FEED (Teknik Fisika UGM)",
  "private": true,
  "scripts": {
    "postinstall": "npm ci --prefix apps/operations-cockpit",
    "dev": "npm run dev --prefix apps/operations-cockpit",
    "build": "node tools/build_manifest.js && npm run build --prefix apps/operations-cockpit",
    "data:cockpit": "node tools/build_manifest.js",
    "check": "node tools/check_companions.js",
    "sync:dwsim": "python tools/dwsim/export_hmb.py",
    "calc": ".venv\\Scripts\\python tools/calc/run_all.py",
    "test:py": ".venv\\Scripts\\python -m pytest tools/dwsim tools/calc tools/test_validate_tags.py -q -p no:cacheprovider",
    "validate:tags": ".venv\\Scripts\\python tools/validate_tags.py",
    "sync:push": "node tools/sync/sync.js push",
    "sync:pull": "node tools/sync/sync.js pull",
    "pull:sheets": "node tools/sync/pull_sheets.js"
  },
  "keywords": [
    "capstone",
    "dme",
    "feed",
    "dwsim",
    "autocad",
    "ugm"
  ],
  "author": "Rahul Ghulam Hidayatulloh & Area-1 Team",
  "license": "ISC",
  "engines": {
    "node": ">=24.12.0"
  }
}
