# Salin menjadi .env.local (tidak di-commit) lalu sesuaikan per perangkat.
# Blueprint v2.0 §8.2: folder Drive TERPISAH dari folder monorepo Git.

# Lokasi folder lokal proyek untuk biner CAD, PDF, bukti WO.
# Contoh setelah Google Drive for Desktop terpasang: G:\My Drive\CAPSTONE_DME_AREA1
# Lokasi saat ini (salinan lokal):                  D:\rahul\CAPSTONE_DME_AREA1
DRIVE_ROOT=D:\rahul\CAPSTONE_DME_AREA1

# ID folder tujuan di Google Drive (bagian akhir URL folder:
# https://drive.google.com/drive/folders/<ID>). Dipakai tools/upload_to_gdrive.js.
GDRIVE_ROOT_FOLDER_ID=
